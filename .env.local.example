# Required
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional — override the Claude model used (default: claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Vercel KV (Redis) for persistent assessment storage.
# Add a KV database in your Vercel project dashboard; it auto-populates these.
# KV_REST_API_URL=https://your-kv.upstash.io
# KV_REST_API_TOKEN=your_kv_token_here
